# Local build environment. The upstream main-code license remains unresolved;
# this file does not authorize publishing a derived image.
ARG ROS_BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${ROS_BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions python3-numpy python3-scipy \
    ros-humble-ros-gz ros-humble-xacro ros-humble-robot-state-publisher \
    ros-humble-ros2-control ros-humble-ros2-controllers ros-humble-ign-ros2-control \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /ws
# Source is mounted at runtime; credentials and project history are never copied.
CMD ["bash"]
